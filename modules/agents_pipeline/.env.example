# Agents pipeline — environment configuration.
#
# Model selection is driven exclusively by the experiment YAML
# (``configs/*.yaml``). The .env file only carries the
# per-provider API keys, the Vertex project/region (keyless — ADC), and
# (optionally) the Ollama endpoint URL. Fill in the credentials for every
# provider your experiment matrix routes to; providers you don't touch can
# stay blank.

# OpenRouter API key — required for any model whose YAML provider is "openrouter"
# (e.g. ``deepseek-v4-flash`` via OpenRouter in the smoke matrix).
OPENROUTER_API_KEY=

# Anthropic API key — required for any model whose YAML provider is "anthropic"
# (e.g. ``haiku45`` in the paper matrix). Native SDK dispatch via
# gha_agents.env._get_anthropic_api_key.
ANTHROPIC_API_KEY=

# OpenAI API key — required for any model whose YAML provider is "openai"
# (e.g. ``gpt54-nano`` in the paper matrix). Native SDK dispatch (api.openai.com)
# via gha_agents.env._get_openai_api_key.
OPENAI_API_KEY=

# Google API key — required for any model whose YAML provider is "gemini"
# (AI-Studio dispatch; the paper's Gemini runs via Vertex — see below). Native SDK dispatch
# (generativelanguage.googleapis.com) via gha_agents.env._get_gemini_api_key.
# Agno's google-genai client reads this var by default
# (agno/models/google/gemini.py:170).
GOOGLE_API_KEY=

# Vertex AI (provider "vertex") — Gemini billed through a Google Cloud project
# instead of AI Studio, so it draws down GCP credits. There is NO API key:
# authentication is Application Default Credentials. One-time setup:
#     gcloud auth application-default login
#     gcloud config set project <YOUR_PROJECT_ID>
#     gcloud services enable aiplatform.googleapis.com
# Then set the project (required) and region (optional, default us-central1).
# Resolved by gha_agents.env._get_vertex_config; Agno reads the same vars
# when vertexai=True (agno/models/google/gemini.py:182-186).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI is optional — the vertex branch forces vertexai=True
# in code regardless — but harmless to set for parity with Agno's own check.
# GOOGLE_GENAI_USE_VERTEXAI=true

# Ollama endpoint — optional, defaults to http://localhost:11434/v1 when
# unset. Used for any model whose YAML provider is "ollama" (optional; the
# study's open-weight models route via OpenRouter, not Ollama). Override only if
# the Ollama daemon runs on a different host/port.
# OLLAMA_BASE_URL=http://localhost:11434/v1
